# Development defaults; never expose development authentication publicly.
APP_ENV=development
AUTH_MODE=development
SEED_SAMPLE=true
DATABASE_URL=sqlite:///data/explorer.db
HOST=127.0.0.1
PORT=8000
COOKIE_SECURE=false

# Company production deployment: set APP_ENV=production, AUTH_MODE=entra,
# SEED_SAMPLE=false, COOKIE_SECURE=true and use a new PostgreSQL database.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# ENTRA_TENANT_ID=YOUR_TENANT_UUID
# ENTRA_CLIENT_ID=YOUR_BROWSER_APP_CLIENT_UUID
# ENTRA_AUDIENCE=YOUR_API_APP_CLIENT_UUID
# ENTRA_SCOPE=api://YOUR_API_APP_CLIENT_UUID/access_as_user
# Explicit access grants keyed by Entra user object ID. No implicit role grants.
# ENTRA_ACCESS_MAP='{"USER_OBJECT_UUID":{"role":"admin"},"OWNER_OBJECT_UUID":{"role":"owner","unit":"eng"}}'

# Optional SharePoint / OneDrive workbook import via application permissions.
# GRAPH_TENANT_ID=YOUR_TENANT_UUID
# GRAPH_CLIENT_ID=YOUR_GRAPH_APP_CLIENT_UUID
# GRAPH_CLIENT_SECRET=SUPPLY_SECURELY
# GRAPH_DRIVE_ID=YOUR_DRIVE_ID
# GRAPH_ITEM_ID=YOUR_WORKBOOK_ITEM_ID
# GRAPH_POLL_SECONDS=300
